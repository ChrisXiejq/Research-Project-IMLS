core/scripts/models/*_carla_finetuned*_training_log.csv

# Frozen predictor assets are external inputs; their expected identities are
# recorded in experiment manifests rather than bundled in Git.

# --- TensorFlow ---
*.tfevents*

# --- Local env files ---
.env
.env.local
*.local.yml

# Local diagnostic extracts from smoke tests; canonical summaries live under
# docs/paper/generated and the server-side raw archives remain external.
tmp/

# Local experiment evidence. Publish only the explicit compact allowlist under
# docs/paper/generated/ via materialize_publication_evidence.py.
artifacts/

